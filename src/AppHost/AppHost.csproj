<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>MeetupPlanner.AppHost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Javascript" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Keycloak" Version="17.0.0-preview.1.26567.5" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Yarp" Version="17.0.0" />
  </ItemGroup>

  <ItemGroup Label="CommunityToolkit">
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.McpInspector" Version="17.0.0" />
  </ItemGroup>

</Project>
